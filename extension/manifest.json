{
  "manifest_version": 3,
  "name": "Vyral Companion",
  "version": "1.1.0",
  "description": "Posts the videos you approved in Vyral on TikTok, Instagram and YouTube, in your own browser.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://www.tiktok.com/*",
    "https://www.instagram.com/*",
    "https://studio.youtube.com/*",
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Vyral Companion"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.tiktok.com/*",
        "https://www.instagram.com/*",
        "https://studio.youtube.com/*",
        "https://www.youtube.com/*"
      ],
      "js": [
        "sites/whoami.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.tiktok.com/tiktokstudio/upload*",
        "https://www.tiktok.com/creator-center/upload*"
      ],
      "js": [
        "common.js",
        "sites/tiktok.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "common.js",
        "sites/instagram.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://studio.youtube.com/*"
      ],
      "js": [
        "common.js",
        "sites/youtube.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icon.png"
  }
}
