{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Clipper",
  "version": "0.1.0",
  "identifier": "app.aiclipper.desktop",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'none'; style-src 'unsafe-inline'"
    },
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Video",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "externalBin": ["binaries/clippr-backend"],
    "resources": { "../../frontend/dist/": "ui/" },
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
