{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vyral",
  "version": "0.3.3",
  "identifier": "app.vyral.desktop",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; img-src 'self' data:"
    },
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../frontend/dist/": "ui/",
      "service/": "service/"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "shortDescription": "Vyral",
    "longDescription": "Watches clipping accounts and turns new posts into ready-to-upload clips from the original stream.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdCOUZDN0E4Q0M3MzBGNEYKUldSUEQzUE1xTWVmZTV5Uk9xVm55eFNISUZ1cHlteEJ5ZFpPajNpRzlxSno4cjdydTV2TnZpOUcK",
      "endpoints": [
        "https://github.com/Drewzyy/vyral-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}